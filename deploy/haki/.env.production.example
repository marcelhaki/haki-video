# HAKI Video — Cap Web self-host configuration.
#
# PLACEHOLDERS ONLY. This file is committed and the repo is public (AGPL
# section 13 requires offering source to network users), so never put real
# values here. Set the real values in Railway's variable UI, or in an
# untracked deploy/haki/.env.production alongside this file.

# --- Core -------------------------------------------------------------------
# WEB_URL and NEXTAUTH_URL must both be the public https origin, no trailing
# slash. WEB_URL must also be present at BUILD time: apps/web/Dockerfile pins
# NEXT_PUBLIC_WEB_URL to localhost:3000, and packages/env/build.ts resolves
# WEB_URL ?? NEXT_PUBLIC_WEB_URL, so WEB_URL is what overrides it. This is why
# the image is built per-deployment rather than pulled from ghcr.
WEB_URL=https://video.usehaki.com
NEXTAUTH_URL=https://video.usehaki.com

# openssl rand -hex 32
NEXTAUTH_SECRET=REPLACE_ME_32_BYTE_HEX
DATABASE_ENCRYPTION_KEY=REPLACE_ME_32_BYTE_HEX

# Railway injects this when you attach a MySQL service. Cap needs MySQL,
# not Postgres. The ssl parameter is required for Railway's managed MySQL.
DATABASE_URL=mysql://user:pass@host:3306/railway?ssl={"rejectUnauthorized":false}

# --- Object storage ---------------------------------------------------------
# Any S3-compatible endpoint. S3_PATH_STYLE follows the provider's URL style:
# true for MinIO and R2 (path-style), false for Railway buckets, which report
# urlStyle "virtual-host" from `railway bucket credentials`. Railway also
# generates its own bucket name with a random suffix and reports region "auto";
# use the reported values, not the name passed to `railway bucket create`.
CAP_AWS_BUCKET=haki-video-xxxxxxxxxxxxxx
CAP_AWS_REGION=auto
CAP_AWS_ACCESS_KEY=REPLACE_ME
CAP_AWS_SECRET_KEY=REPLACE_ME
S3_PUBLIC_ENDPOINT=https://t3.storageapi.dev
S3_INTERNAL_ENDPOINT=https://t3.storageapi.dev
S3_PATH_STYLE=false

# --- Login email ------------------------------------------------------------
# Without these, login links are written to the server logs instead of sent.
# Usable for a solo instance; required before anyone else can sign in.
RESEND_API_KEY=
RESEND_FROM_DOMAIN=

# --- Access control ---------------------------------------------------------
# Leave CAP_ALLOWED_SIGNUP_DOMAINS unset and ANYONE who reaches the URL can
# create an account. Set it before the instance is publicly reachable.
CAP_ALLOWED_SIGNUP_DOMAINS=haki.marketing
CAP_VIDEOS_DEFAULT_PUBLIC=true

# --- Optional ---------------------------------------------------------------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- Deliberately unset -----------------------------------------------------
# NEXT_PUBLIC_IS_CAP must stay unset. packages/utils/src/constants/plans.ts
# returns userIsPro() === true whenever it is falsy, which is how upstream
# grants self-hosted instances the full feature set. Setting it to any value
# turns on Stripe plan gating and locks features behind a subscription that
# a self-hosted instance cannot sell.
